# Endpoint do formulário de contato (opcional).
# Sem esta variável, o envio é simulado e os dados aparecem no console do navegador.
#
# Formspree:  https://formspree.io/f/SEU_ID_DO_FORMULARIO
# Web3Forms:  https://api.web3forms.com/submit
VITE_CONTACT_ENDPOINT=

# Chave de acesso do Web3Forms (necessária apenas ao usar o Web3Forms).
# Atenção: variáveis VITE_ ficam visíveis no JavaScript publicado. A chave do Web3Forms
# é pública por design; não coloque aqui segredos de outros serviços.
VITE_WEB3FORMS_ACCESS_KEY=
